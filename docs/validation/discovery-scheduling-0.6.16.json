  "regressions": {
    "baseline_commit": "be0e2a1",
    "reproduced_before_fix": "With Runtime still awaiting scan_dlna inline, a route.plan command queued after dlna.scan produced no result within two seconds on the local private network interface. The same integration test passed after asynchronous discovery was connected to Runtime.",
    "coverage": [
      "pending completion can be cancelled repeatedly without losing its result",
      "directory is committed before publishing the device event",
      "replacement discards completed but undelivered old results and clears the directory",
      "stop joins pending work and discards undelivered results",
      "failed searches produce bounded diagnostics and permit retry",
      "interrupting task stop retains the handle until the worker exits",
      "previously published devices remain selectable after stop",
      "normal Engine commands run while DLNA discovery is pending"
    ]
  },
